cabal-version: 3.6
name: sapiens-domain
version: 0.2.0.0
build-type: Simple

flag linux-desktop
  description: Build the GTK Linux desktop
  default: False
  manual: True

common runtime
  hsc2hs-options: --cross-compile --via-asm
  default-language: Haskell2010
  default-extensions: OverloadedStrings, ScopedTypeVariables, TupleSections
  ghc-options: -threaded -rtsopts -O1 -Wall -Werror=incomplete-patterns -Werror=incomplete-uni-patterns -Werror=missing-fields
  build-depends: base >=4.18 && <5, aeson ==2.3.2.0, bytestring, text, containers,
    directory, filepath, process, time, async, stm, scientific, vector,
    sqlite-simple, filelock, uuid, base64-bytestring, network-uri, regex-tdfa,
    http-client, http-client-tls, http-types, network, wai, warp, wai-websockets,
    websockets, wuss, cryptohash-sha256, entropy, memory, random, tagsoup ==0.14.8
  if !os(windows)
    build-depends: unix

executable sapiens-domain
  main-is: Main.hs
  hs-source-dirs: corpora/work/schedule
  other-modules: Command, Wire
  build-depends: base >=4.18 && <5, aeson ==2.3.2.0, bytestring
  default-language: Haskell2010
  ghc-options: -O2 -Wall -Werror

common macos-update
  if os(osx)
    other-modules: Installation, UpdatePlatform, UpdateNative, ObjC
    c-sources: environments/macos/Cocoa.c
    extra-libraries: objc
    frameworks: Cocoa
    cc-options: -Wno-deprecated-declarations

common host
  import: macos-update
  hs-source-dirs: corpora, corpora/state, corpora/work, corpora/work/schedule, corpora/host, corpora/telemetry, remote/relay, remote/control, remote/protocol, build, environments/update
  other-modules:
    Command,
    Admission,
    Domain,
    RuntimePaths,
    Telemetry,
    TelemetryDevice,
    TelemetryWire,
    TelemetryModel,
    TelemetryProtocol,
    Paths_sapiens_domain,
    DataRoot,
    UpdateState,
    HostUpdateProtocol,
    Assets,
    BuildUI,
    Computer,
    Delegation,
    Execution,
    GroupChat,
    GroupModel,
    GroupWork,
    Groups,
    HTTP,
    Management,
    Memo,
    Mcp,
    Population,
    Provider,
    Onboarding,
    Bridge,
    Client,
    Crypto,
    BrowserCrypto,
    Mailboxes,
    Registry,
    Receipt,
    Server,
    Setup,
    Transport,
    Routines,
    HostServer,
    Service,
    Store,
    Types,
    Voice,
    Workspace,
    Wire
  if os(windows)
    hs-source-dirs: environments/windows
    other-modules: Installation, UpdatePlatform, UpdateNative
    extra-libraries: user32, advapi32

  if os(osx)
    hs-source-dirs: environments/macos

executable sapiens4
  import: runtime, host
  main-is: Main.hs

executable sapiens-linux
  import: runtime, host
  hs-source-dirs: environments/linux
  main-is: LinuxMain.hs
  if os(linux) && flag(linux-desktop)
    c-sources: environments/linux/Desktop.c, environments/linux/Browser.c
    pkgconfig-depends: gtk+-3.0 >=3.24, webkit2gtk-4.1 >=2.40, json-glib-1.0
    cc-options: -Wall -Wextra -Werror
  else
    buildable: False

executable sapiens-macos
  import: runtime, macos-update
  hs-source-dirs: environments/macos, environments, environments/update, corpora/state, corpora/telemetry
  other-modules:
    Admission,
    Domain,
    RuntimePaths,
    Telemetry,
    TelemetryDevice,
    TelemetryWire,
    TelemetryModel,
    TelemetryProtocol,
    Paths_sapiens_domain,
    DataRoot,
    UpdateState,
    HostUpdateProtocol,
    DesktopStorage,
    Types,
    Application,
    Browser,
    Icon,
    Update,
    UpdateBackup
  main-is: MacMain.hs
  if os(osx)
    c-sources: environments/macos/Process.c
    frameworks: WebKit, CoreGraphics
    extra-libraries: objc
  else
    buildable: False

executable sapiens-macos-starter
  import: runtime, macos-update
  hs-source-dirs: environments/macos, environments/update
  main-is: Starter.hs
  other-modules: UpdateState
  if !os(osx)
    buildable: False

common windows-host
  import: runtime
  other-modules:
    Installation,
    UpdateState,
    HostUpdateProtocol,
    UpdatePlatform,
    UpdateNative,
    Admission,
    Domain,
    RuntimePaths,
    Telemetry,
    TelemetryDevice,
    TelemetryWire,
    TelemetryModel,
    TelemetryProtocol,
    Paths_sapiens_domain,
    DataRoot,
    DesktopStorage,
    Types,
    Browser,
    Host,
    Native,
    Navigation,
    Shell,
    Update,
    UpdateBackup
  if os(windows)
    c-sources: environments/windows/WebView.c
    extra-libraries: user32, ole32, dwmapi, comdlg32, kernel32, advapi32
  else
    buildable: False

executable sapiens-windows
  import: windows-host
  hs-source-dirs: environments/windows, environments, environments/update, corpora/state, corpora/telemetry
  main-is: WindowsMain.hs
  if os(windows)
    ld-options: .build/haskell/windows-resources.o
    ghc-options: -optl-mwindows

executable sapiens-starter
  import: runtime
  hs-source-dirs: environments/windows, environments/update
  main-is: Starter.hs
  other-modules: Installation, UpdateState, UpdatePlatform, UpdateNative
  if os(windows)
    extra-libraries: user32, advapi32
    ghc-options: -optl-mwindows
  else
    buildable: False
