cabal-version: 3.0
name: sapiens-telemetry
version: 0.1.0.0
build-type: Simple

common collector
  default-language: GHC2021
  default-extensions: OverloadedStrings, ScopedTypeVariables
  ghc-options: -Wall -threaded -rtsopts -O1 -Werror=incomplete-patterns -Werror=missing-fields
  hs-source-dirs: ., ../../corpora/telemetry
  build-depends: base >=4.20 && <5, aeson >=2.1 && <2.3, bytestring, text,
    containers, vector, time, directory, filepath, uuid,
    wai, warp, http-types, unix, wireform-parquet ==0.1.0.0
  other-modules: Collector, TelemetryProtocol

executable sapiens-telemetry
  import: collector
  main-is: Main.hs
