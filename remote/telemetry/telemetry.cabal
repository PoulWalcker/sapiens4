cabal-version: 3.0
name: telemetry
version: 0.1.0.0
build-type: Simple

executable telemetry
  main-is: Main.hs
  other-modules: Auth
  build-depends:
    base >= 4.20 && < 4.21,
    crypton == 2.2.6,
    ram == 0.22.1,
    bytestring >= 0.12 && < 0.13,
    uuid == 1.3.16.1,
    wireform-parquet == 0.1.0.0
  default-language: GHC2021