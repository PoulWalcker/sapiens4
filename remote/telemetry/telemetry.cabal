cabal-version: 3.0
name: telemetry
version: 0.1.0.0
build-type: Simple

executable telemetry
  main-is: Main.hs
  other-modules:
    Auth
    Parquet
    Protocol
  build-depends:
    aeson >= 2.1.2 && < 2.4,
    async >= 2.2 && < 2.3,
    base >= 4.20 && < 4.21,
    bytestring >= 0.12 && < 0.13,
    crypton == 2.2.6,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    http-types >= 0.12 && < 0.13,
    ram == 0.22.1,
    stm >= 2.5 && < 2.6,
    text >= 2.1 && < 2.2,
    time >= 1.12 && < 1.13,
    unix >= 2.8 && < 2.9,
    uuid == 1.3.16.1,
    vector >= 0.13 && < 0.14,
    wai >= 3.2.4 && < 3.3,
    warp >= 3.4 && < 3.5,
    wireform-parquet == 0.1.0.0
  default-language: GHC2021
  ghc-options: -Wall -threaded
